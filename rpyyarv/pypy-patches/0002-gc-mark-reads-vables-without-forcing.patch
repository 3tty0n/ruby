+class _JitframeMarkCache(object):
+    """One (token, generation) pair: the mark hook reads a frame's fields
+    consecutively, so remembering the last walked jitframe keeps the walk
+    at one per frame per collection."""
+    def __init__(self):
+        self.token = TOKEN_NONE
+        self.generation = -1
+
+_jitframe_mark_cache = _JitframeMarkCache()
+
+
+def _mark_jitframe_words(token):
+    """Every word of a compiled frame through the embedder's conservative
+    mark callback: spilled values live in the jitframe, which an external
+    GC's stack scan cannot see, and walking it does not deoptimize."""
+    cache = _jitframe_mark_cache
+    if cache.token == token and \
+            cache.generation == gc_mark_state.generation:
+        return
+    cache.token = token
+    cache.generation = gc_mark_state.generation
+    cb = gc_mark_state.mark_word
+    if cb is None:
+        return
+    from rpython.jit.backend.llsupport import jitframe
+    frame = lltype.cast_opaque_ptr(lltype.Ptr(jitframe.JITFRAME), token)
+    i = 0
+    n = len(frame.jf_frame)
+    while i < n:
+        cb(frame.jf_frame[i])
+        i += 1
+_mark_jitframe_words._dont_inline_ = True
