+class _GCMarkState(object):
+    """Set by an embedder's GC mark hook around reading virtualizable fields:
+    during tracing those fields are always correct, so a read that only marks
+    must not clear vable_token and read as an escape."""
+    def __init__(self):
+        self.marking = False
+        # Bumped by the embedder per collection, so the jitframe walk cache
+        # in metainterp/virtualizable.py never satisfies a stale hit.
+        self.generation = 0
+        # Embedder callback marking one machine word conservatively.
+        self.mark_word = None
+
+
+gc_mark_state = _GCMarkState()
+
