+def fuse_rotates(operations):
+    """Turn (x >>u k) | (x << 64-k) into one ROR; tagged-float codecs are full of them."""
+    if not _maybe_has_rotate(operations):
+        return operations
+    uses = {}
+    _count_uses(operations, uses)
+    shift_src = {}
+    shift_amount = {}
+    shift_right = {}
+    for op in operations:
+        opnum = op.getopnum()
+        if opnum == rop.UINT_RSHIFT or opnum == rop.INT_LSHIFT:
+            amount = op.getarg(1)
+            if isinstance(amount, ConstInt) and 0 < amount.getint() < 64:
+                shift_src[op] = op.getarg(0)
+                shift_amount[op] = amount.getint()
+                shift_right[op] = opnum == rop.UINT_RSHIFT
+    rename = {}                 # value -> value, for args and failargs
+    newop_of = {}               # op -> op, for the operation list itself
+    dropped = {}
+    for op in operations:
+        if op.getopnum() != rop.INT_OR:
+            continue
+        a = op.getarg(0)
+        b = op.getarg(1)
+        if a is b or a not in shift_src or b not in shift_src:
+            continue
+        if uses.get(a, 0) != 1 or uses.get(b, 0) != 1:
+            continue
+        if shift_src[a] is not shift_src[b]:
+            continue
+        if shift_right[a] == shift_right[b]:
+            continue
+        if shift_amount[a] + shift_amount[b] != 64:
+            continue
+        right = shift_amount[a] if shift_right[a] else shift_amount[b]
+        ror = ResOperation(rop.INT_ROR, [shift_src[a], ConstInt(right)])
+        newop_of[op] = ror
