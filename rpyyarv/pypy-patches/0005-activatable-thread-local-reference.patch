diff --git a/rpython/rlib/rthread.py b/rpython/rlib/rthread.py
index 89ec31c..3e1314c 100644
--- a/rpython/rlib/rthread.py
+++ b/rpython/rlib/rthread.py
@@ -455,6 +455,46 @@ class ThreadLocalReference(ThreadLocalField):
                 (not _win32 or config.translation.shared))
 
 
+class ActivatableThreadLocalReference(object):
+    """A thread-local reference with a single-thread fast path.
+
+    Before activate() the value lives in an ordinary field, avoiding a TLS
+    access.  activate() copies that value to the calling thread's TLS slot and
+    permanently switches all accesses to TLS.  The caller must serialize the
+    transition and call it before another thread can access this object.
+    """
+    _immutable_fields_ = ['_activated?']
+
+    @not_rpython
+    def __init__(self, Cls, initial=None, loop_invariant=False):
+        "must be prebuilt"
+        assert isinstance(initial, Cls) or initial is None
+        self._tls = ThreadLocalReference(Cls,
+                                         loop_invariant=loop_invariant)
+        self._main_value = initial
+        self._activated = False
+
+    def get(self):
+        if self._activated:
+            return self._tls.get()
+        return self._main_value
+
+    def set(self, value):
+        if self._activated:
+            self._tls.set(value)
+        else:
+            self._main_value = value
+
+    def activate(self):
+        if self._activated:
+            return
+        self._tls.set(self._main_value)
+        self._activated = True
+
+    def is_activated(self):
+        return self._activated
+
+
 tlfield_thread_ident = ThreadLocalField(lltype.Signed, "thread_ident",
