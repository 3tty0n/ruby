+    def test_activatable_tlref(self):
+        class FooBar(object):
+            pass
+        first = FooBar()
+        second = FooBar()
+        t = ActivatableThreadLocalReference(FooBar, first)
+        def f():
+            assert t.get() is first
+            t.set(second)
+            assert t.get() is second
+            t.activate()
+            assert t.get() is second
+            import gc; gc.collect()
+            assert t.get() is second
