@@ -51,6 +51,30 @@ def test_tlref_untranslated():
     time.sleep(0.5)
     assert results == [True] * 15
 
+
+def test_activatable_tlref_untranslated():
+    import thread
+    class FooBar(object):
+        pass
+    first = FooBar()
+    second = FooBar()
+    t = ActivatableThreadLocalReference(FooBar, first)
+    assert not t.is_activated()
+    assert t.get() is first
+    t.set(second)
+    assert t.get() is second
+    t.activate()
+    assert t.is_activated()
+    assert t.get() is second
+    results = []
+    def subthread():
+        results.append(t.get() is None)
+        t.set(first)
+        results.append(t.get() is first)
+    thread.start_new_thread(subthread, ())
+    time.sleep(0.2)
+    assert results == [True, True]
+
